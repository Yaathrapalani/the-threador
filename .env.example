# ==============================================================================
# THE THREADOR - ENVIRONMENT CONFIGURATION (SAMPLE / PLACEHOLDER)
# ==============================================================================
# Copy this file to .env.local for local overrides.
# Never commit real credentials, secret API keys, or private tokens to Git.
# ==============================================================================

# Application Meta
VITE_APP_TITLE="THE THREADOR"
VITE_APP_DESCRIPTION="Haute Couture 3D Experience, Fashion Education & Costume Atelier Rooted in India"

# Studio & Concierge Contact (Verified Placeholders)
VITE_WHATSAPP_NUMBER="919876543210"
VITE_CONTACT_EMAIL="connect@thethreador.com"

# Razorpay Payment Gateway (Sandbox Scaffolding)
# Real transactions require founder-approved merchant credentials
VITE_RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"

# 3D Asset Pipeline Configuration
# Path relative to public root for external production GLB asset
VITE_HERO_GARMENT_GLB_PATH="/models/hero-garment.glb"

# Local Development Server Port
VITE_PORT=3000
